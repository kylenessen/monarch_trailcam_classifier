{
  "name": "monarch-image-labeler",
  "productName": "Monarch Image Labeler",
  "version": "1.1.1",
  "description": "A desktop application for classifying monarch butterflies in trail-camera photos",
  "author": "Kyle Nessen",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron src/main/main.js",
    "test:e2e": "playwright test",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.kylenessen.monarchtrailcamclassifier",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ]
  },
  "keywords": [
    "electron",
    "monarch",
    "butterfly",
    "classification"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.13.14",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
